# Development Database Environment Variables
# For development, SISPA 1.0 connects to a local PostgreSQL instance.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Example for Supabase migration (when migrating to your personal database later):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Optional WhatsApp Cloud API / Twilio Integration
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_secret_verify_token
# WHATSAPP_API_TOKEN=your_meta_whatsapp_cloud_api_token
# WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
